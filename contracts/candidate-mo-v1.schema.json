{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Jeevan-0508/freight-fraud-taxonomy/blob/main/contracts/candidate-mo-v1.schema.json",
  "title": "Risk ecosystem candidate MO interchange v1",
  "description": "A reviewable handoff of a candidate generated by the synthetic Fraud Watch simulator. It is not taxonomy truth or a real-world incident record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "data_class",
    "exported_at",
    "simulation",
    "source",
    "taxonomy",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": "candidate-mo.v1"
    },
    "kind": {
      "const": "candidate_mo"
    },
    "data_class": {
      "const": "synthetic_simulation"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "sim_time_seconds_from_genesis"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "description": "The simulator run seed. It supports reproducibility only when paired with the exact source revision and runtime behavior; it does not authenticate this export."
        },
        "sim_time_seconds_from_genesis": {
          "type": "integer",
          "minimum": 0,
          "description": "Simulation clock at export time, distinct from exported_at wall-clock time."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_url",
        "revision",
        "authenticity"
      ],
      "properties": {
        "repository": {
          "const": "Jeevan-0508/fraud-watch"
        },
        "repository_url": {
          "const": "https://github.com/Jeevan-0508/fraud-watch"
        },
        "revision": {
          "description": "Exact source revision when the running build can establish it; otherwise null.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "authenticity": {
          "const": "unverified_export"
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "source_commit",
        "snapshot_sha256"
      ],
      "properties": {
        "repository": {
          "const": "Jeevan-0508/freight-fraud-taxonomy"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "description": "Pinned source commit when the simulator build has it; otherwise null.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_sha256": {
          "description": "SHA-256 of the exact taxonomy snapshot bytes when known; otherwise null.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "signature",
        "lifecycle_state",
        "source_state",
        "time_basis",
        "first_seen_at",
        "candidate_since",
        "review_started_at",
        "resolved_at",
        "resolution_note",
        "supporting_cases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fraud-watch:.+",
          "description": "Namespaced from the candidate signature. It identifies this signature, not a real-world event."
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "description": "Simulator signal-type signature used to group candidate sightings."
        },
        "lifecycle_state": {
          "description": "Candidate export lifecycle. Promotion is intentionally outside this contract and requires a separately reviewed taxonomy update.",
          "enum": [
            "DISCOVERED",
            "UNDER_REVIEW",
            "VALIDATED",
            "REJECTED"
          ]
        },
        "source_state": {
          "description": "The literal state recorded by the current Fraud Watch candidate engine.",
          "enum": [
            "CANDIDATE",
            "REVIEW",
            "VALIDATED",
            "REJECTED"
          ]
        },
        "time_basis": {
          "const": "simulation_seconds_from_genesis"
        },
        "first_seen_at": {
          "type": "number",
          "minimum": 0,
          "description": "Earliest case openedAt among the cases present when this candidate record was created; not the earliest signal firstObserved time."
        },
        "candidate_since": {
          "type": "number",
          "minimum": 0,
          "description": "Simulation time when the candidate record was created after reaching the sighting floor; this is not real-world promotion."
        },
        "review_started_at": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "resolved_at": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "resolution_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "supporting_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "classification",
              "classification_reason",
              "recorded_at",
              "case_opened_at",
              "first_observed_at",
              "signal_types",
              "related_pattern_id",
              "correlation_index",
              "correlation_index_semantics"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^MO-[0-9]+$"
              },
              "classification": {
                "description": "Classification copied from append-only candidate provenance at recorded_at. It may differ from current_classification because the case can be re-derived later.",
                "enum": [
                  "KNOWN_MO",
                  "MO_VARIANT",
                  "POTENTIAL_NEW_MO",
                  "EMERGING_BEHAVIOR"
                ]
              },
              "current_classification": {
                "description": "Current MO classification at exported_at, which may differ from the candidate provenance snapshot above.",
                "enum": [
                  "KNOWN_MO",
                  "MO_VARIANT",
                  "POTENTIAL_NEW_MO",
                  "EMERGING_BEHAVIOR"
                ]
              },
              "classification_reason": {
                "description": "Current MO classification reason at exported_at; the candidate provenance record does not retain a reason snapshot from recorded_at.",
                "type": "string",
                "maxLength": 500
              },
              "recorded_at": {
                "type": "number",
                "minimum": 0,
                "description": "Simulation time when this case was added to candidate provenance; not the case's first observation time."
              },
              "case_opened_at": {
                "type": "number",
                "minimum": 0,
                "description": "Current MO record value at exported_at."
              },
              "first_observed_at": {
                "type": "number",
                "minimum": 0,
                "description": "Current MO record value at exported_at."
              },
              "signal_types": {
                "description": "Distinct signal types in the current MO evidence record at exported_at. This is not necessarily the candidate signature captured when the candidate was created.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "related_pattern_id": {
                "description": "Current heuristic taxonomy resemblance recorded on the MO at exported_at; this is not a validated mapping.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^FFT-[0-9]{3}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "correlation_index": {
                "description": "Current MO correlation index at exported_at. It is a simulator-defined index, not a probability.",
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "correlation_index_semantics": {
                "const": "synthetic_signal_index_not_probability"
              }
            }
          }
        }
      }
    }
  }
}
