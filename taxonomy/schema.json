{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Freight & Carrier Fraud Pattern",
  "description": "Schema for a single fraud pattern entry in the Freight & Carrier Fraud Risk Taxonomy.",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "severity",
    "prevalence",
    "modes",
    "summary",
    "how_it_works",
    "indicators",
    "false_positives",
    "countermeasures",
    "references",
    "version",
    "last_reviewed"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FFT-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "enum": [
        "identity",
        "contractual",
        "cargo_loss",
        "documentary",
        "digital",
        "insider",
        "financial",
        "regulatory"
      ]
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Expert-authored typical consequence category; not a measured loss distribution."
    },
    "prevalence": {
      "enum": [
        "rare",
        "occasional",
        "common",
        "endemic"
      ],
      "description": "Expert-authored qualitative prevalence descriptor; not a measured incident frequency or calibrated probability."
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "road",
          "rail",
          "sea",
          "air",
          "intermodal",
          "parcel"
        ]
      }
    },
    "geography": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regions where the pattern is most reported."
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "how_it_works": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      },
      "description": "Ordered mechanics of the pattern."
    },
    "indicators": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "phase",
          "signal",
          "observable_in",
          "weight"
        ],
        "additionalProperties": false,
        "properties": {
          "phase": {
            "enum": [
              "pre_award",
              "in_transit",
              "post_event"
            ]
          },
          "signal": {
            "type": "string"
          },
          "observable_in": {
            "type": "string",
            "description": "Where the signal can actually be seen: a data field, document, system or physical check."
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Authored indicator weight from 1 to 5 for coverage scoring; not a fraud probability or proof by itself."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "false_positives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "looks_like",
          "actually",
          "how_to_rule_out"
        ],
        "additionalProperties": false,
        "properties": {
          "looks_like": {
            "type": "string"
          },
          "actually": {
            "type": "string"
          },
          "how_to_rule_out": {
            "type": "string"
          }
        }
      }
    },
    "countermeasures": {
      "type": "object",
      "required": [
        "preventive",
        "detective",
        "responsive"
      ],
      "additionalProperties": false,
      "properties": {
        "preventive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detective": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "responsive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "regulatory_hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "instrument",
          "provision",
          "relevance"
        ],
        "additionalProperties": false,
        "properties": {
          "instrument": {
            "type": "string"
          },
          "provision": {
            "type": "string"
          },
          "relevance": {
            "type": "string"
          }
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FFT-[0-9]{3}$"
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "simulation_recipe": {
      "description": "Authored synthetic Fraud Watch execution recipe. A simulator capability mapping, not evidence of real-world occurrence or prevalence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "version",
        "generation_order",
        "plan_id",
        "label",
        "target_node_types",
        "steps"
      ],
      "properties": {
        "engine": {
          "const": "fraud-watch"
        },
        "version": {
          "const": 1
        },
        "generation_order": {
          "type": "integer",
          "minimum": 0
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "target_node_types": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "PORT",
                  "FULFILLMENT_CENTER",
                  "REGIONAL_HUB",
                  "DEPOT",
                  "WAREHOUSE",
                  "CHECKPOINT"
                ]
              }
            }
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "test"
            ],
            "properties": {
              "type": {
                "enum": [
                  "UNEXPECTED_STOP",
                  "ROUTE_DEVIATION",
                  "DRIVER_CHANGED",
                  "TRAILER_SWAPPED",
                  "MANIFEST_CHANGED",
                  "SEAL_MISMATCH",
                  "GPS_SIGNAL_LOST",
                  "FALSE_MILESTONE_STAMP",
                  "CARRIER_UNRESPONSIVE",
                  "EQUIPMENT_CARRIER_MISMATCH",
                  "DUPLICATE_ASSET_ID",
                  "HANDOVER_GAP",
                  "STAGED_BREAKDOWN",
                  "ACCOUNT_TAKEOVER"
                ]
              },
              "test": {
                "enum": [
                  "AT_NODE",
                  "ON_LEG_INTO_NODE",
                  "AT_NODE_TYPE"
                ]
              },
              "nodeType": {
                "enum": [
                  "PORT",
                  "FULFILLMENT_CENTER",
                  "REGIONAL_HUB",
                  "DEPOT",
                  "WAREHOUSE",
                  "CHECKPOINT"
                ]
              }
            }
          }
        }
      }
    }
  }
}
